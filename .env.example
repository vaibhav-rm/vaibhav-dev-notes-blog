VITE_APPWRITE_URL=https://cloud.appwrite.io/v1
VITE_PROJECT_ID=your_appwrite_project_id
VITE_DATABASE_ID=your_database_id
VITE_COLLECTION_ID=your_posts_collection_id
VITE_COMMENTS_COLLECTION_ID=your_comments_collection_id
VITE_BUCKET_ID=your_storage_bucket_id
VITE_FUNCTION_ID=your_cloud_function_id
VITE_EDITOR_API=your_tinymce_api_key

# Canonical origin of the deployed site. Must have NO trailing slash.
# Change this to your custom domain once you own one, and keep it in sync
# with Cloudflare Pages, robots.txt and scripts/generate-seo.js.
VITE_SITE_URL=https://vaibhavnotes.pages.dev

# Optional. Google Analytics 4 measurement ID. If unset, analytics is disabled.
VITE_GA_MEASUREMENT_ID=
